{
  "manifest_version": 3,
  "name": "YouTube Quick Unsubscribe",
  "version": "1.3.0",
  "description": "Adds a one-click Unsubscribe button to the YouTube subscriptions list (youtube.com/feed/channels).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
